{
"redirects": [
{ "source": "/imobiliaria", "destination": "/imobiliaria/", "permanent": false },
  { "source": "/eventos", "destination": "/eventos/", "permanent": false }
],
"rewrites": [
{ "source": "/imobiliaria/", "destination": "https://haja-imobiliario.vercel.app/" },
{ "source": "/imobiliaria/:path*", "destination": "https://haja-imobiliario.vercel.app/:path*" },
  { "source": "/eventos/", "destination": "https://haja-eventos.vercel.app/" },
  { "source": "/eventos/:path*", "destination": "https://haja-eventos.vercel.app/:path*"  }
]
}
